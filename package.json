{
  "name": "pharmavault-trustrag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-local.cjs",
    "test:integration-ui": "node --test tests/project-integration/client.test.cjs",
    "test:readiness": "node --test backend/tests/chatProviderReadiness.test.js backend/tests/publicProviderProbe.test.js tests/v2-01/readiness-client.test.cjs tests/v2-01/readiness-schema.test.cjs",
    "test:readiness:http": "node --test backend/tests/chatProviderReadinessIntegration.test.js",
    "check:chat-provider": "node backend/scripts/checkChatProvider.js",
    "dev:chat:backend": "node backend/scripts/startChatDemo.js",
    "test:chat": "node --test backend/tests/chatRag.test.js backend/tests/conversationalRag.test.js backend/tests/pharmacyChatPolicy.test.js backend/tests/chatMentorScenarios.test.js tests/chatClient.test.cjs",
    "build": "npm run check:ts && vite build",
    "build:frontend": "npm run check:ts && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:frontend": "npm run lint",
    "check:ts": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check:backend:syntax": "node scripts/check-backend-syntax.cjs",
    "test:security": "npm --prefix backend run test:security",
    "test:trustrag": "npm --prefix backend run test:trustrag",
    "test:backend": "npm --prefix backend test",
    "validate:contract": "redocly lint contracts/openapi/pharmavault-trustrag-v1.yaml",
    "validate:schemas": "ajv compile -s 'contracts/schemas/*.schema.json' --spec=draft2020 -c ajv-formats",
    "seed:catalogue": "npm --prefix backend run seed:catalogue",
    "preview": "vite preview",
    "seed:all": "npm --prefix backend run seed:all"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "axios": "^1.7.9",
    "date-fns": "^3.0.6",
    "gsap": "^3.15.1",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.309.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.0.0",
    "react-router-dom": "7.18.6",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.82.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
