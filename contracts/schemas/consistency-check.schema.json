{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmavault.example/schemas/consistency-check.schema.json",
  "title": "ConsistencyCheck",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "caseId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "checkType": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE"]
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "message": { "type": "string" },
    "evidenceItemIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" }
    },
    "rulesetVersion": { "type": "string" },
    "reviewRequired": { "type": "boolean" }
  },
  "required": ["id", "caseId", "checkType", "status", "severity", "message", "rulesetVersion", "reviewRequired"],
  "additionalProperties": false
}
