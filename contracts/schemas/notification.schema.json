{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmavault.example/schemas/notification.schema.json",
  "title": "Notification",
  "description": "In-app status notification. Contains no medicine names, amounts or document text.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "type": { "type": "string", "maxLength": 64 },
    "title": { "type": "string", "maxLength": 160 },
    "body": { "type": "string", "maxLength": 500 },
    "link": { "type": ["string", "null"], "maxLength": 300 },
    "readAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "emailDelivery": { "type": "string", "enum": ["NOT_CONFIGURED", "QUEUED", "SENT", "FAILED"] }
  },
  "required": ["id", "type", "title", "body", "link", "readAt", "createdAt"],
  "additionalProperties": false
}
