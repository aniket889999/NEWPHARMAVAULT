{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmavault.example/schemas/review-decision.schema.json",
  "title": "ReviewDecision",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "caseId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "reviewerId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "decision": {
      "type": "string",
      "enum": ["APPROVE", "REJECT", "REQUEST_CLARIFICATION", "ESCALATE"]
    },
    "reasonCode": { "type": "string" },
    "notes": { "type": "string" },
    "evidenceItemIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "caseId", "reviewerId", "decision", "reasonCode", "createdAt"],
  "additionalProperties": false
}
