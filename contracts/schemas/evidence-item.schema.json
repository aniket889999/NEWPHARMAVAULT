{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmavault.example/schemas/evidence-item.schema.json",
  "title": "EvidenceItem",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "caseId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "sourceId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "documentId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "claimSupported": { "type": "string" },
    "evidenceText": { "type": "string" },
    "pageNumber": { "type": "integer", "minimum": 1 },
    "boundingBox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "sourceUrl": { "type": "string" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "contentHash": { "type": "string" },
    "sourceVersion": { "type": "string" },
    "trustTier": { "type": "integer", "minimum": 1, "maximum": 5 },
    "sourceType": {
      "type": "string",
      "enum": ["CASE_DOCUMENT", "CANONICAL_CATALOG", "OFFICIAL_REGISTRY"]
    },
    "sourceLabel": { "type": "string" },
    "relevanceReason": { "type": "string" }
  },
  "required": ["id", "caseId", "sourceId", "claimSupported", "evidenceText", "retrievedAt", "trustTier"],
  "additionalProperties": false
}
