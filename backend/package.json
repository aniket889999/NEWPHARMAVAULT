{
  "name": "pharmavault-backend",
  "version": "1.0.0",
  "description": "Backend API for PharmaVault",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:security": "node --test tests/security.test.js",
    "test:trustrag": "node --test tests/trustRag.test.js",
    "test:evidence": "node --test tests/evidenceRoutingExplainability.test.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "data:import": "node seeder.js",
    "seed:catalogue": "node seeders/catalogueSeeder.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.4",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.6",
    "pdf-to-img": "^7.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  }
}
