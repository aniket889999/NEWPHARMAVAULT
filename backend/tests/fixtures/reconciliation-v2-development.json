{
  "schemaVersion": "2.0.0-session2-dev-fixtures",
  "synthetic": true,
  "label": "SYNTHETIC — DEMO ONLY",
  "split": "development",
  "description": "Development-only synthetic fixtures for PharmaVault Session 2 medicine matching and administrative quantity normalization tests. Contains no patient data or held-out benchmark scenarios.",
  "quantityUnitCases": [
    {
      "id": "QTY-DEV-01",
      "description": "Direct tablet count normalization",
      "slots": {
        "medicine_name": "Paracetamol",
        "dosage_strength": "500 mg",
        "dosage_form": "tablet",
        "quantity": "10",
        "quantity_unit": "tablets"
      },
      "expected": {
        "status": "NORMALIZED",
        "baseQuantity": 10,
        "baseUnit": "tablet",
        "reasonCodes": []
      }
    },
    {
      "id": "QTY-DEV-02",
      "description": "Direct capsule count normalization with abbreviation",
      "slots": {
        "medicine_name": "Omeprazole",
        "dosage_strength": "20 mg",
        "dosage_form": "capsule",
        "quantity": "15",
        "quantity_unit": "cap"
      },
      "expected": {
        "status": "NORMALIZED",
        "baseQuantity": 15,
        "baseUnit": "capsule",
        "reasonCodes": []
      }
    },
    {
      "id": "QTY-DEV-03",
      "description": "Direct liquid mL decimal quantity normalization",
      "slots": {
        "medicine_name": "Calpol Suspension",
        "dosage_strength": "120mg/5ml",
        "dosage_form": "syrup",
        "quantity": "62.5",
        "quantity_unit": "mL"
      },
      "expected": {
        "status": "NORMALIZED",
        "baseQuantity": 62.5,
        "baseUnit": "mL",
        "reasonCodes": []
      }
    },
    {
      "id": "QTY-DEV-04",
      "description": "Explicit strip pack count multiplication (2 strips x 6 tablets = 12 tablets)",
      "slots": {
        "medicine_name": "Paracetamol",
        "dosage_strength": "500 mg",
        "dosage_form": "tablet",
        "quantity": "2",
        "quantity_unit": "strip",
        "pack_size": "6",
        "pack_unit": "tablet"
      },
      "expected": {
        "status": "NORMALIZED",
        "baseQuantity": 12,
        "baseUnit": "tablet",
        "reasonCodes": []
      }
    },
    {
      "id": "QTY-DEV-05",
      "description": "Strip without explicit pack_size never defaults to 10",
      "slots": {
        "medicine_name": "Paracetamol",
        "dosage_strength": "500 mg",
        "dosage_form": "tablet",
        "quantity": "2",
        "quantity_unit": "strip",
        "pack_unit": "tablet"
      },
      "expected": {
        "status": "INSUFFICIENT_EVIDENCE",
        "baseQuantity": null,
        "baseUnit": null,
        "reasonCodes": ["UNKNOWN_PACK_SIZE"]
      }
    },
    {
      "id": "QTY-DEV-06",
      "description": "Unsupported bottle unit requires clarification",
      "slots": {
        "medicine_name": "Calpol Suspension",
        "dosage_strength": "120mg/5ml",
        "dosage_form": "syrup",
        "quantity": "1",
        "quantity_unit": "bottle"
      },
      "expected": {
        "status": "INSUFFICIENT_EVIDENCE",
        "baseQuantity": null,
        "baseUnit": null,
        "reasonCodes": ["UNKNOWN_QUANTITY_UNIT"]
      }
    }
