NODE_ENV=development
PORT=5001
# Browser clients only. Use a comma-separated HTTPS allow-list in production.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only when a trusted TLS reverse proxy is directly in front of the API.
TRUST_PROXY=0
MONGO_URI=
# Production: a unique, rotated secret of 32+ characters. Never commit it.
JWT_SECRET=
# Server-side only. It is not used by the iPhone app or frontend bundle.
GEMINI_API_KEY=
# TrustRAG external explanations require BOTH flags. Disabled by default.
TRUSTRAG_LLM_ENABLED=false
TRUSTRAG_LLM_EXPORT_ALLOWED=false
GEMINI_MODEL=gemini-2.5-flash
EMAIL_USER=
EMAIL_PASS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_DOC_MAX=120
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# Production only: absolute path to a persistent, access-controlled encrypted volume.
DOCUMENT_STORAGE_ROOT=
# Local Tesseract language-data folder. Provision it locally; no runtime download.
TRUSTRAG_TESSDATA_PATH=
