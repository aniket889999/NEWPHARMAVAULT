NODE_ENV=development
PORT=5001
# Browser clients only. Use a comma-separated HTTPS allow-list in production.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only when a trusted TLS reverse proxy is directly in front of the API.
TRUST_PROXY=0
MONGO_URI=
# Production: a unique, rotated secret of 32+ characters. Never commit it.
JWT_SECRET=
# Server-side only; optional for production local-only mode when all provider
# flags below are false. Development legacy routes still require this key.
# Never put it in the iPhone app or frontend bundle.
GEMINI_API_KEY=
# TrustRAG external explanations require BOTH flags. Disabled by default.
TRUSTRAG_LLM_ENABLED=false
TRUSTRAG_LLM_EXPORT_ALLOWED=false
GEMINI_MODEL=gemini-2.5-flash
# Chat-only controls. Private case evidence remains local regardless of these.
RAG_CHAT_LLM_ENABLED=false
RAG_CHAT_PUBLIC_EXPORT_ALLOWED=false
RAG_CHAT_EMBEDDINGS_ENABLED=false
RAG_CHAT_MODEL=gemini-2.5-flash
# Official MedlinePlus health-topic lookup using registry terms only. No key.
RAG_CHAT_WEB_ENABLED=false
# Separately permit synthesis of accepted official web excerpts. Never private data.
RAG_CHAT_WEB_SYNTHESIS_ALLOWED=false
EMAIL_USER=
EMAIL_PASS=
# Claims notifications are always in-app; email only when this is true AND EMAIL_* are set.
NOTIFY_EMAIL_ENABLED=false
# Opt-in SMS/WhatsApp alerts: POST {to, channel, text} to your gateway adapter (https). Indian SMS needs DLT templates.
NOTIFY_TEXT_ENABLED=false
TEXT_GATEWAY_URL=
TEXT_GATEWAY_TOKEN=
# TOTP MFA: 32+ random characters, used to encrypt authenticator secrets at rest.
MFA_ENCRYPTION_KEY=
# Launch hardening (keep false for local demo; set true in staging/production).
# Staff and insurer accounts must turn on MFA before they can use anything else.
MFA_REQUIRED_FOR_STAFF=false
# A final VERIFY needs a professional registration confirmed by an org admin (Team & Access).
REVIEW_CREDENTIAL_REQUIRED=false
# Per-account sign-in lockout.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Lock the whole account only after this many failures from all addresses together.
LOGIN_ACCOUNT_MAX_FAILURES=50
# Audit hash chain: HMAC key (32+ chars) kept OUTSIDE the database. Without it the chain
# still detects edits, but someone with database write access could rebuild it.
AUDIT_CHAIN_KEY=
# Operations: json logs (default in production) and Prometheus metrics at /api/metrics (404 unless set, 32+ chars).
LOG_FORMAT=
# ACCESS_LOG=false turns per-request logs off (metrics still count requests).
ACCESS_LOG=
METRICS_TOKEN=
# Multi-instance safety. 'mongo' = MongoDB lease locks / shared rate-limit counters.
CASE_LOCK_BACKEND=memory
CASE_LOCK_LEASE_MS=120000
RATE_LIMIT_STORE=memory
# Documents + page previews encrypted at rest (AES-256-GCM) when set (32+ chars).
# Existing plaintext files stay readable; encrypt them with: npm run documents:encrypt -- --apply
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_REQUIRED=false
# Retention: content of finished cases with no open claims is removed after N days.
RETENTION_JOB_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_CASE_DAYS=365
RETENTION_NOTIFICATION_DAYS=180
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_DOC_MAX=120
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# Production only: absolute path to a persistent, access-controlled encrypted volume.
DOCUMENT_STORAGE_ROOT=
# Local Tesseract language-data folder. Provision it locally; no runtime download.
TRUSTRAG_TESSDATA_PATH=
